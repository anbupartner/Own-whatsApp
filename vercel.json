{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?path=:path*" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "30 3 * * *" }
  ]
}
