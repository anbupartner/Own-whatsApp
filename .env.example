# Copy this file to .env and fill in your values (needed for Cloud API mode only).
# Get them from https://developers.facebook.com -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v21.0
PORT=3000

# Optional locally, required on Vercel: first admin's password and admin recovery password
APP_PASSWORD=
# Admin username (default: admin)
# APP_USERNAME=admin

# Vercel only (set these in the Vercel dashboard, not in .env):
# CRON_SECRET=          long random string, sent by Vercel Cron as "Authorization: Bearer <CRON_SECRET>"
# KV_REST_API_URL / KV_REST_API_TOKEN   added automatically when you connect Upstash Redis
# MISSED_GRACE_HOURS=6  skip a scheduled run that is more than this many hours late
# Optional: delivered/read tracking (can also be set on the Setup page)
# META_APP_SECRET=
# WEBHOOK_VERIFY_TOKEN=
